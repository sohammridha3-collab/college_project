# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_USER=admission_user
DB_PASSWORD=your_strong_mysql_password_here
DB_NAME=admission_portal

# Security (Generate a 64+ char random hex string in production)
JWT_SECRET=replace_with_a_secure_random_secret_in_production
SESSION_COOKIE_NAME=portal_token

# CORS and Frontend Origins (Comma-separated list of allowed origins)
CORS_ORIGIN=https://admission.youruniversity.edu,https://portal.youruniversity.edu
CLIENT_URL=https://admission.youruniversity.edu

# Protected File Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Payment Gateway Configuration
# Default is 'mock' which simulates verified server-side transactions
PAYMENT_GATEWAY_PROVIDER=mock
# When integrating Stripe / Razorpay in production, provide API keys:
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
